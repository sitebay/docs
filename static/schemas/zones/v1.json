{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sitebay.org/docs/schemas/zones/v1.json",
  "title": "SiteBay Page Contract — zones manifest v1",
  "type": "object",
  "required": ["contract", "renderer", "zones"],
  "properties": {
    "$schema": { "type": "string" },
    "contract": { "const": 1 },
    "manifest_version": { "type": "integer", "minimum": 1 },
    "renderer": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "enum": ["wp", "shopify", "static"] },
        "theme": { "type": "string" }
      },
      "additionalProperties": false
    },
    "fidelity": { "type": "integer", "minimum": 0, "maximum": 1 },
    "description": { "type": "string" },
    "field_registry": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": { "type": "string" },
          "label": { "type": "string" },
          "max_chars": { "type": "integer", "minimum": 0 },
          "hint": { "type": "string" },
          "default": {},
          "schema": { "type": "object" },
          "zone": { "type": "string" },
          "binding": { "type": "object" }
        },
        "additionalProperties": false
      }
    },
    "zones": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "label": { "type": "string" },
          "edit_mode": { "type": "string" },
          "description": { "type": "string" },
          "fields": { "type": "array", "items": { "type": "string" } },
          "binding": { "type": "object" }
        },
        "additionalProperties": false
      }
    },
    "pages": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "path": { "type": "string" },
          "editing_model": { "type": "string" },
          "note": { "type": "string" },
          "zones": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "agent_memory": {
      "type": "object",
      "description": "Agent state stored on the site (Shopify metafields, WP .sitebay/ path). Not zones.",
      "additionalProperties": { "type": "object" }
    },
    "agent_rules": {
      "type": "object",
      "properties": {
        "editing_model": {},
        "canvas_notification": {},
        "clone_missions": {},
        "commit_path": {},
        "selector_strategy": {},
        "css_changes": {},
        "new_pages": {},
        "do_not": {}
      },
      "additionalProperties": false
    },
    "field_discovery": { "type": "string" }
  },
  "additionalProperties": false
}
